# Base de datos PostgreSQL (Neon o local)
DATABASE_URI=postgresql://usuario:password@localhost:5432/ocanaturismo

# Secret para Payload CMS (mínimo 32 caracteres aleatorios)
PAYLOAD_SECRET=cambia-esto-por-un-secret-seguro-de-32-chars

# URL del sitio
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary (sin usar actualmente — el storage de medios es Vercel Blob)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Vercel Blob — storage de la colección Medios (persiste en Vercel serverless).
# Crear en el dashboard de Vercel: Storage → Create → Blob, y copiar el token.
# Sin esta variable, Payload usa filesystem local (solo válido en desarrollo).
BLOB_READ_WRITE_TOKEN=
